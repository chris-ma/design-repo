# Appwrite project (create one at https://cloud.appwrite.io or point at your self-hosted instance)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# API key with Database (read/write) and Storage (read/write) scopes
APPWRITE_API_KEY=

# Provisioned automatically by `npm run setup` — safe to leave at these defaults
APPWRITE_DATABASE_ID=design-inspo-db
APPWRITE_ITEMS_COLLECTION_ID=items
APPWRITE_SCREENSHOTS_BUCKET_ID=screenshots

# Anthropic API key for screenshot tagging + replication prompt generation
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Local dev only: explicit path to a local Chromium executable for screenshot capture.
# Usually auto-detected via PLAYWRIGHT_BROWSERS_PATH after `npx playwright install chromium` — only set this if detection fails.
# PLAYWRIGHT_CHROMIUM_PATH=

# Production (Vercel) only: URL to a hosted @sparticuz/chromium-min pack tar.
# Defaults to the matching official GitHub release; override if you host your own copy.
# CHROMIUM_PACK_URL=
